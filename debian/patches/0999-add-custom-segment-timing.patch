+// Determines whether to enable alternative end_pts calculation.
+// Input seek position and start_number should match a m3u8 file already generated.
+static int end_pts_resume_from_start_number(VariantStream *vs, AVStream *st, HLSContext *hls)
+{
+    if (vs->start_pts <= 0 ||
+        vs->start_pts == AV_NOPTS_VALUE ||
+        hls->start_sequence == 0 ||
+        (hls->flags & HLS_SPLIT_BY_TIME) ||
+        hls->init_time > 0) {
+        return AVERROR(EINVAL);
+    }
+
+    if (hls->start_sequence > INT64_MAX / hls->recording_time) {
+        return AVERROR(EOVERFLOW);
+    }
+    int64_t start_sequence_time = hls->start_sequence * hls->recording_time;
+    if (av_compare_ts(vs->start_pts, st->time_base, start_sequence_time, AV_TIME_BASE_Q) < 0) {
+        return AVERROR(EINVAL);
+    }
+
+    return 0;
+}
